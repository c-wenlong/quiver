# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv
venv/
env/

# Packaging / tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
coverage*.json
coverage.xml
htmlcov/

# OS
.DS_Store
# Partial-write temp files some editors and copy tools leave next to the
# real file (".!12345!name.py").
.!*!*

# Local user state — never commit these (machine-specific / may contain secrets)
mcp.json
harness.json
tools.json
providers.json
stars.json
session_cache.json
completions/

# .archive/ — parked, not part of the build
.archive/

# Nix build output
result
result-*

# Local credentials for release work.
.env
.env.*

# Build output a checkout made before the apps moved to app/mac and
# app/ios; nothing is tracked at these paths any more.
/app/.build/
/remote/ios/

# Swift/Xcode build leftovers
*.dSYM
*.dSYM.zip
*.xcresult
.swiftpm/

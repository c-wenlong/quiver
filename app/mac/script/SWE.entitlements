<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Open in Terminal, account sign-in and session resume drive Terminal
       and iTerm through an osascript child. TCC charges that Apple Event
       to SWE, and under the hardened runtime (prod and notarized
       builds) an app without this entitlement is refused with -1743
       before any prompt appears. NSAppleEventsUsageDescription in
       Info.plist is the prompt's text. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
